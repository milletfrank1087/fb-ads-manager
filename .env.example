FB_ACCESS_TOKEN=
FB_USER_ACCESS_TOKEN=
FB_TARGET_PAGE_ID=
FB_BUSINESS_ID=

FB_AD_ACCOUNT_ID=
FB_PRIMARY_ACCOUNT_ID=act_xxxxxxxxxxxxxxxx
FB_PRIMARY_ACCOUNT_TIMEZONE=Europe/Kiev

FB_SYSTEM_USER_NAME=fb-ads-manager-sysuser
FB_SYSTEM_USER_ACCESS_TOKEN=

FB_APP_ID=
FB_APP_SECRET=

PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=

GRAPH_API_VERSION=v25.0

REQUEST_TIMEOUT_SECONDS=30
MIN_REQUEST_INTERVAL_MS=750

FB_READONLY=1
# Gated separately from FB_READONLY. 1 = allow comment hide/delete; 0 = view-only.
FB_ALLOW_COMMENT_MODERATION=0
# Gated separately from FB_READONLY. 1 = allow ad pause/resume + budget edits; 0 = view-only.
FB_ALLOW_AD_MANAGEMENT=0
FB_KILL_SWITCH=0
FB_MAX_DAILY_CALLS=500
FB_CIRCUIT_BREAKER_THRESHOLD=2
FB_CIRCUIT_BREAKER_COOLDOWN_SECONDS=300

PORT=3000
LOG_LEVEL=info

# AI advisor (OpenRouter). Leave OPENROUTER_API_KEY empty to disable AI features.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_SYNTHESIS_MODEL=google/gemini-3-flash-preview

# --- Access control -------------------------------------------------------
# REQUIRED before exposing the app on a public URL (e.g. Railway). When
# APP_PASSWORD is set the whole app is gated behind HTTP Basic Auth. Left empty
# only for local development (the server logs a loud warning and stays open).
APP_USERNAME=admin
APP_PASSWORD=
