# Copy to .env and fill in. Never commit .env.

# --- Meta ---
FB_APP_ID=
FB_APP_SECRET=
# System-user token (never expires). The Page token is derived from it at runtime.
FB_SYSTEM_USER_ACCESS_TOKEN=
FB_TARGET_PAGE_ID=
# Optional: limit ad-post discovery to these ad accounts (comma-separated act_ ids). Empty = every account the token can see.
FB_AD_ACCOUNT_IDS=
FB_PRIMARY_ACCOUNT_TIMEZONE=Europe/Kiev
GRAPH_API_VERSION=v25.0

# --- Proxy (optional: leave all four empty to connect to Meta directly) ---
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=

# --- Safety ---
# Hard gate for every write to Facebook (hide/delete/reply/block). 0 = review only.
FB_ALLOW_COMMENT_MODERATION=0
FB_KILL_SWITCH=0
FB_MAX_DAILY_CALLS=500
MIN_REQUEST_INTERVAL_MS=750
REQUEST_TIMEOUT_SECONDS=30
FB_CIRCUIT_BREAKER_THRESHOLD=2
FB_CIRCUIT_BREAKER_COOLDOWN_SECONDS=300

# --- AI review (OpenRouter, called directly — never through the Meta proxy) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_FALLBACK_MODEL=google/gemini-3-flash-preview
LLM_TIMEOUT_SECONDS=60
ANALYSIS_BATCH_SIZE=10
ANALYSIS_BATCH_CONCURRENCY=3

# --- Fetching ---
CM_BATCH_SIZE=25
CM_MAX_COMMENT_PAGES_PER_POST=5

# --- Server ---
PORT=3000
LOG_LEVEL=info
# Where the SQLite file lives. On Railway, point this at a mounted volume (e.g. /data)
# or the database is wiped on every deploy.
DATA_DIR=
DB_FILE=automod.db
